{
  "packages": {
    ".": {
      "release-type": "python",
      "package-name": "promptfoo",
      "changelog-path": "CHANGELOG.md",
      "bump-minor-pre-major": true,
      "bump-patch-for-minor-pre-major": true,
      "extra-files": [
        {
          "type": "toml",
          "path": "uv.lock",
          "jsonpath": "$.package[?(@.name.value == 'promptfoo')].version"
        }
      ]
    }
  }
}
